<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sumworry - Scientific Text Analysis</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <script>
        tailwind.config = {
            darkMode: ["class"],
            theme: {
                extend: {
                    colors: {
                        border: "hsl(var(--border))",
                        input: "hsl(var(--input))",
                        ring: "hsl(var(--ring))",
                        background: "hsl(var(--background))",
                        foreground: "hsl(var(--foreground))",
                        primary: {
                            DEFAULT: "hsl(var(--primary))",
                            foreground: "hsl(var(--primary-foreground))",
                        },
                        secondary: {
                            DEFAULT: "hsl(var(--secondary))",
                            foreground: "hsl(var(--secondary-foreground))",
                        },
                        destructive: {
                            DEFAULT: "hsl(var(--destructive))",
                            foreground: "hsl(var(--destructive-foreground))",
                        },
                        muted: {
                            DEFAULT: "hsl(var(--muted))",
                            foreground: "hsl(var(--muted-foreground))",
                        },
                        accent: {
                            DEFAULT: "hsl(var(--accent))",
                            foreground: "hsl(var(--accent-foreground))",
                        },
                        card: {
                            DEFAULT: "hsl(var(--card))",
                            foreground: "hsl(var(--card-foreground))",
                        },
                    },
                    borderRadius: {
                        lg: "var(--radius)",
                        md: "calc(var(--radius) - 2px)",
                        sm: "calc(var(--radius) - 4px)",
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --background: 240 10% 3.9%;
            --foreground: 0 0% 98%;
            --card: 240 10% 3.9%;
            --card-foreground: 0 0% 98%;
            --popover: 240 10% 3.9%;
            --popover-foreground: 0 0% 98%;
            --primary: 0 0% 98%;
            --primary-foreground: 240 5.9% 10%;
            --secondary: 240 3.7% 15.9%;
            --secondary-foreground: 0 0% 98%;
            --muted: 240 3.7% 15.9%;
            --muted-foreground: 240 5% 64.9%;
            --accent: 240 3.7% 15.9%;
            --accent-foreground: 0 0% 98%;
            --destructive: 0 62.8% 30.6%;
            --destructive-foreground: 0 0% 98%;
            --border: 240 3.7% 15.9%;
            --input: 240 3.7% 15.9%;
            --ring: 240 4.9% 83.9%;
            --radius: 0.75rem;
            color-scheme: dark;
        }

        body {
            background-color: hsl(var(--background));
            color: hsl(var(--foreground));
            font-family: ui-sans-serif, system-ui, sans-serif;
        }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: hsl(var(--muted-foreground) / 0.2); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: hsl(var(--muted-foreground) / 0.4); }

        .glass-card {
            background: hsl(var(--card));
            border: 1px solid hsl(var(--border));
            border-radius: var(--radius);
            box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        }

        .metric-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .metric-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 40px -12px rgba(0, 0, 0, 0.5);
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel" data-type="module">
        import React, { useState, useMemo, useEffect } from 'https://esm.sh/react@18.2.0';
        import { createRoot } from 'https://esm.sh/react-dom@18.2.0/client';
        import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip as RechartsTooltip, ResponsiveContainer, ReferenceLine } from 'https://esm.sh/recharts@2.12.0';
        import { Activity, BookOpen, Brain, MessageSquare, Type, Zap, AlertTriangle, CheckCircle, Info, BarChart2, Hash, Clock, Layers } from 'https://esm.sh/lucide-react@0.344.0';

        // ============================================================================
        // 1. SCIENTIFIC ANALYSIS LOGIC (Ported from scientificAnalysis.ts & textAnalysis.ts)
        // ============================================================================

        const VADER_LEXICON = {
            'excellent': 3.2, 'perfect': 3.5, 'amazing': 3.4, 'awesome': 3.3, 'wonderful': 3.3, 'fantastic': 3.5, 'incredible': 3.3, 'outstanding': 3.3, 'brilliant': 3.2, 'love': 3.4,
            'great': 2.5, 'good': 2.1, 'happy': 2.3, 'pleased': 2.2, 'satisfied': 2.0, 'glad': 2.1, 'grateful': 2.4, 'blessed': 2.5, 'lucky': 2.0, 'successful': 2.4, 'positive': 2.0,
            'better': 1.5, 'improved': 1.6, 'enhanced': 1.5, 'helpful': 1.7, 'useful': 1.5, 'practical': 1.3, 'fun': 1.6, 'funny': 1.5, 'enjoyable': 1.7, 'safe': 1.7, 'secure': 1.8,
            'hope': 1.2, 'dream': 1.0, 'wish': 0.6, 'meaningful': 1.0, 'purposeful': 0.9, 'worthwhile': 1.1,
            'boring': -1.4, 'dull': -1.3, 'tedious': -1.5, 'slow': -1.1, 'poor': -1.8, 'weak': -1.5, 'hard': -0.8, 'difficult': -1.3, 'sad': -1.9, 'unhappy': -1.7, 'lonely': -1.6,
            'bad': -2.2, 'terrible': -2.6, 'awful': -2.5, 'horrible': -2.7, 'dreadful': -2.4, 'disgusting': -2.5, 'hate': -2.8, 'loathe': -2.9, 'despise': -2.8, 'angry': -2.0, 'evil': -2.9,
            'fail': -2.0, 'failure': -2.1, 'disaster': -2.4, 'crisis': -2.2, 'damage': -1.8, 'harm': -2.0, 'hurt': -1.9, 'loss': -1.6, 'lose': -1.7, 'death': -2.7, 'die': -2.5,
            'the': 0, 'is': 0, 'are': 0, 'was': 0, 'and': 0, 'or': 0, 'but': -0.1, 'no': -0.3, 'not': -0.5
        };

        function getCapitalizationBoost(word) {
            if (word.length < 2) return 0;
            const upperCount = (word.match(/[A-Z]/g) || []).length;
            const ratio = upperCount / word.length;
            if (ratio > 0.7) return 0.733; 
            if (ratio > 0.4) return 0.3;   
            return 0;
        }

        function isNegation(word) {
            const negations = ['not', 'no', 'never', 'neither', 'nobody', 'nothing', 'none', 'cannot', 'cant', 'wont', 'wouldnt', 'shouldnt', 'couldnt', 'dont', 'doesnt', 'didnt', 'isnt', 'arent', 'wasnt', 'werent', 'hasnt', 'havent', 'hadnt', 'without', 'lack', 'missing'];
            return negations.includes(word.toLowerCase());
        }

        function getIntensifierBoost(word) {
            const intensifiers = { 'very': 0.293, 'really': 0.2, 'truly': 0.25, 'extremely': 0.4, 'absolutely': 0.35, 'completely': 0.25, 'totally': 0.25, 'quite': 0.15, 'pretty': 0.1, 'somewhat': 0.05, 'hardly': -0.3, 'barely': -0.3 };
            return intensifiers[word.toLowerCase()] || 0;
        }

        function countSyllables(word) {
            word = word.toLowerCase().replace(/[^a-z]/g, '');
            if (word.length === 0) return 0;
            if (word.length <= 3) return 1;
            const vowels = 'aeiouy';
            let count = 0;
            let prevWasVowel = false;
            for (let i = 0; i < word.length; i++) {
                const isVowel = vowels.includes(word[i]);
                if (isVowel && !prevWasVowel) count++;
                prevWasVowel = isVowel;
            }
            if (word.endsWith('e')) count--;
            if (word.endsWith('le') && word.length > 2 && !vowels.includes(word[word.length - 3])) count++;
            if (count === 0) count = 1;
            return count;
        }

        function vaderSentiment(text) {
            if (!text || text.trim().length === 0) return { compound: 0, positive: 0, neutral: 1, negative: 0, label: 'Neutral' };
            const sentences = text.match(/[^.!?]+[.!?]+/g) || [text];
            let totalCompound = 0, totalPositive = 0, totalNegative = 0, totalNeutral = 0;
            
            sentences.forEach(sentence => {
                const words = sentence.toLowerCase().match(/\b[\w']+\b/g) || [];
                const originalWords = sentence.match(/\b[\w']+\b/g) || [];
                if (words.length === 0) return;
                
                let sentenceScore = 0;
                let wordScores = [];
                let negationActive = false;
                let intensifierBoost = 0;
                
                for (let i = 0; i < words.length; i++) {
                    const word = words[i];
                    if (isNegation(word)) { negationActive = true; continue; }
                    
                    const intensifier = getIntensifierBoost(word);
                    if (intensifier !== 0) { intensifierBoost = intensifier; continue; }
                    
                    let wordSentiment = VADER_LEXICON[word] || 0;
                    if (wordSentiment !== 0) {
                        const capBoost = getCapitalizationBoost(originalWords[i] || word);
                        if (intensifierBoost > 0) wordSentiment += (wordSentiment > 0 ? intensifierBoost : -intensifierBoost);
                        else if (intensifierBoost < 0) wordSentiment *= (1 + intensifierBoost);
                        
                        if (negationActive) wordSentiment *= -0.5;
                        wordSentiment *= (1 + capBoost);
                        wordScores.push(wordSentiment);
                        
                        negationActive = false; intensifierBoost = 0;
                    }
                }
                
                if (wordScores.length > 0) {
                    const sumScore = wordScores.reduce((a, b) => a + b, 0);
                    sentenceScore = sumScore / Math.sqrt(sumScore * sumScore + 15);
                }
                
                const pos = wordScores.filter(s => s > 0.05);
                const neg = wordScores.filter(s => s < -0.05);
                const neu = wordScores.filter(s => Math.abs(s) <= 0.05);
                
                totalPositive += pos.length;
                totalNegative += neg.length;
                totalNeutral += neu.length + (words.length - wordScores.length);
                totalCompound += sentenceScore;
            });
            
            const totalWords = totalPositive + totalNegative + totalNeutral || 1;
            const compound = Math.max(-1, Math.min(1, totalCompound / Math.max(1, sentences.length)));
            const positive = totalPositive / totalWords;
            const negative = totalNegative / totalWords;
            const neutral = Math.max(0, 1 - positive - negative);
            
            let label;
            if (compound >= 0.5) label = 'Very Positive';
            else if (compound >= 0.2) label = 'Positive';
            else if (compound >= 0.05) label = 'Slightly Positive';
            else if (compound <= -0.5) label = 'Very Negative';
            else if (compound <= -0.2) label = 'Negative';
            else if (compound <= -0.05) label = 'Slightly Negative';
            else label = 'Neutral';
            
            return { compound, positive, neutral, negative, label };
        }

        function calculateLIX(text) {
            const sentences = text.match(/[^.!?]+[.!?]+/g) || [text];
            const words = text.match(/\b[\w']+\b/g) || [];
            const longWords = words.filter(w => w.length > 6);
            if (sentences.length === 0 || words.length === 0) return { score: 0, interpretation: 'N/A' };
            
            const lix = (words.length / sentences.length) + ((longWords.length * 100) / words.length);
            let interpretation;
            if (lix < 30) interpretation = 'Easy (Fiction)';
            else if (lix < 40) interpretation = 'Standard (Newspapers)';
            else if (lix < 50) interpretation = 'Difficult (Technical)';
            else interpretation = 'Very Difficult (Academic)';
            
            return { score: Math.round(lix), interpretation };
        }

        function analyzeText(text) {
            if (!text || text.trim().length === 0) return null;

            const cleanText = text.trim();
            const words = cleanText.toLowerCase().match(/\b[\w']+\b/g) || [];
            const sentences = cleanText.match(/[^.!?]+[.!?]+/g) || [cleanText];
            
            const totalCharacters = cleanText.length;
            const totalWords = words.length;
            const totalSentences = sentences.length;
            
            const averageSentenceLength = totalSentences > 0 ? totalWords / totalSentences : 0;
            const syllableCounts = words.map(countSyllables);
            const totalSyllables = syllableCounts.reduce((sum, count) => sum + count, 0);
            const averageSyllablesPerWord = totalWords > 0 ? totalSyllables / totalWords : 0;
            const complexWords = words.filter(word => countSyllables(word) >= 3).length;

            const estimatedReadingTime = (totalWords / 225) * 60; // seconds
            const fleschReadingEase = 206.835 - (1.015 * averageSentenceLength) - (84.6 * averageSyllablesPerWord);
            
            let readingGrade = 'Standard';
            if (fleschReadingEase >= 80) readingGrade = 'Easy';
            else if (fleschReadingEase < 50) readingGrade = 'Difficult';

            const sentiment = vaderSentiment(text);
            const lix = calculateLIX(text);

            const uniqueWords = new Set(words).size;
            const lexicalDiversity = totalWords > 0 ? uniqueWords / totalWords : 0;

            return {
                basic: { totalCharacters, totalWords, totalSentences },
                reading: { estimatedReadingTime, readingEase: fleschReadingEase, readingGrade },
                readability: { lix: lix.score, lixInterpretation: lix.interpretation },
                vocabulary: { uniqueWords, lexicalDiversity, complexWords },
                sentiment
            };
        }

        function dftSmooth(data, smoothingFactor = 0.3) {
            const n = data.length;
            if (n === 0) return [];
            const real = new Array(n).fill(0);
            const imag = new Array(n).fill(0);
            for (let k = 0; k < n; k++) {
                for (let t = 0; t < n; t++) {
                    const angle = (2 * Math.PI * k * t) / n;
                    real[k] += data[t] * Math.cos(angle);
                    imag[k] -= data[t] * Math.sin(angle);
                }
            }
            const cutoff = Math.floor(n * smoothingFactor);
            for (let k = cutoff; k < n; k++) { real[k] = 0; imag[k] = 0; }
            const smoothed = new Array(n).fill(0);
            for (let t = 0; t < n; t++) {
                for (let k = 0; k < n; k++) {
                    const angle = (2 * Math.PI * k * t) / n;
                    smoothed[t] += (real[k] * Math.cos(angle) - imag[k] * Math.sin(angle)) / n;
                }
            }
            return smoothed;
        }

        function generateSentimentPlot(text, numParts = 20) {
            if (!text || text.trim().length === 0) return [];
            const sentences = text.match(/[^.!?]+[.!?]+/g) || [text];
            if (sentences.length < 3) return [];
            
            const adjustedParts = Math.min(Math.max(Math.floor(sentences.length / 2), 5), numParts);
            const sentencesPerPart = Math.ceil(sentences.length / adjustedParts);
            const originalScores = [];
            
            for (let i = 0; i < adjustedParts; i++) {
                const startIdx = i * sentencesPerPart;
                const endIdx = Math.min((i + 1) * sentencesPerPart, sentences.length);
                const chunk = sentences.slice(startIdx, endIdx).join(' ');
                originalScores.push(vaderSentiment(chunk).compound);
            }
            
            const smoothedScores = dftSmooth(originalScores, 0.4);
            return originalScores.map((original, index) => ({
                index,
                original: Math.max(-1, Math.min(1, original)),
                smoothed: Math.max(-1, Math.min(1, smoothedScores[index])),
                position: Math.round((index / (adjustedParts - 1)) * 100)
            }));
        }

        // ============================================================================
        // 2. UI COMPONENTS (Tailwind Recreations of Shadcn UI)
        // ============================================================================

        const Card = ({ children, className = "" }) => (
            <div className={`glass-card p-6 flex flex-col gap-4 ${className}`}>
                {children}
            </div>
        );

        const Metric = ({ icon: Icon, title, value, sub }) => (
            <div className="metric-card bg-zinc-900 border border-zinc-800 rounded-xl p-5 flex flex-col gap-2">
                <div className="flex items-center gap-2 text-zinc-400 font-medium text-sm">
                    <Icon size={16} />
                    {title}
                </div>
                <div className="text-3xl font-bold text-white tracking-tight">{value}</div>
                {sub && <div className="text-xs text-zinc-500">{sub}</div>}
            </div>
        );

        const Badge = ({ children, color = "bg-zinc-800 text-zinc-300" }) => (
            <span className={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${color}`}>
                {children}
            </span>
        );

        // ============================================================================
        // 3. MAIN APPLICATION
        // ============================================================================

        function App() {
            const [text, setText] = useState("");
            
            // Analyze text dynamically
            const analysis = useMemo(() => analyzeText(text), [text]);
            const plotData = useMemo(() => generateSentimentPlot(text), [text]);

            // Formatter helpers
            const formatTime = (secs) => {
                if (secs < 60) return `${Math.round(secs)}s`;
                return `${Math.floor(secs / 60)}m ${Math.round(secs % 60)}s`;
            };

            return (
                <div className="min-h-screen p-4 md:p-8 max-w-6xl mx-auto space-y-8">
                    
                    {/* Header */}
                    <header className="flex flex-col gap-2">
                        <div className="flex items-center gap-3">
                            <Activity className="text-blue-500 w-8 h-8" />
                            <h1 className="text-3xl font-bold tracking-tight text-white">Sumworry</h1>
                        </div>
                        <p className="text-zinc-400">Scientific Text & Sentiment Analysis Engine</p>
                    </header>

                    {/* Input Section */}
                    <section>
                        <textarea 
                            className="w-full min-h-[200px] rounded-xl border border-zinc-800 bg-zinc-900/50 p-4 text-zinc-100 placeholder:text-zinc-600 focus:outline-none focus:ring-2 focus:ring-blue-500/50 resize-y transition-all"
                            placeholder="Paste your text here to begin scientific analysis (requires at least a few sentences for accurate charting)..."
                            value={text}
                            onChange={(e) => setText(e.target.value)}
                        />
                    </section>

                    {/* Results Dashboard */}
                    {analysis ? (
                        <div className="space-y-6 animate-in fade-in duration-500">
                            
                            {/* Key Metrics Grid */}
                            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                                <Metric 
                                    icon={Hash} 
                                    title="Word Count" 
                                    value={analysis.basic.totalWords} 
                                    sub={`${analysis.basic.totalCharacters} characters`}
                                />
                                <Metric 
                                    icon={Clock} 
                                    title="Reading Time" 
                                    value={formatTime(analysis.reading.estimatedReadingTime)} 
                                    sub={`~225 WPM`}
                                />
                                <Metric 
                                    icon={Brain} 
                                    title="Sentiment" 
                                    value={analysis.sentiment.label} 
                                    sub={`Score: ${analysis.sentiment.score.toFixed(2)}`}
                                />
                                <Metric 
                                    icon={BookOpen} 
                                    title="Readability" 
                                    value={analysis.reading.readingGrade} 
                                    sub={`LIX: ${analysis.readability.lix}`}
                                />
                            </div>

                            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                                {/* Chart Section */}
                                {plotData.length > 0 && (
                                    <Card className="lg:col-span-2">
                                        <div className="flex items-center gap-2 mb-4">
                                            <BarChart2 className="w-5 h-5 text-blue-400" />
                                            <h2 className="text-lg font-semibold text-white">Sentiment Progression</h2>
                                        </div>
                                        <div className="h-[300px] w-full">
                                            <ResponsiveContainer width="100%" height="100%">
                                                <LineChart data={plotData} margin={{ top: 5, right: 5, left: -20, bottom: 5 }}>
                                                    <CartesianGrid strokeDasharray="3 3" stroke="#333" vertical={false} />
                                                    <XAxis dataKey="position" stroke="#666" tick={{fill: '#888', fontSize: 12}} tickFormatter={(val) => `${val}%`} />
                                                    <YAxis domain={[-1, 1]} stroke="#666" tick={{fill: '#888', fontSize: 12}} />
                                                    <RechartsTooltip 
                                                        contentStyle={{ backgroundColor: '#18181b', border: '1px solid #3f3f46', borderRadius: '8px' }}
                                                        itemStyle={{ color: '#fff' }}
                                                        labelFormatter={(val) => `Position: ${val}%`}
                                                    />
                                                    <ReferenceLine y={0} stroke="#555" strokeDasharray="3 3" />
                                                    <Line type="monotone" dataKey="smoothed" name="Trend" stroke="#3b82f6" strokeWidth={3} dot={false} activeDot={{r: 6, fill: '#3b82f6'}} />
                                                    <Line type="monotone" dataKey="original" name="Raw" stroke="#6b7280" strokeWidth={1} dot={false} opacity={0.5} />
                                                </LineChart>
                                            </ResponsiveContainer>
                                        </div>
                                    </Card>
                                )}

                                {/* Secondary Stats Section */}
                                <div className={`flex flex-col gap-6 ${plotData.length === 0 ? 'lg:col-span-3 lg:grid lg:grid-cols-3' : 'lg:col-span-1'}`}>
                                    <Card>
                                        <div className="flex items-center gap-2 mb-4">
                                            <Type className="w-5 h-5 text-purple-400" />
                                            <h2 className="text-lg font-semibold text-white">Vocabulary</h2>
                                        </div>
                                        <div className="space-y-4">
                                            <div>
                                                <div className="flex justify-between text-sm mb-1">
                                                    <span className="text-zinc-400">Lexical Diversity</span>
                                                    <span className="text-white font-medium">{(analysis.vocabulary.lexicalDiversity * 100).toFixed(1)}%</span>
                                                </div>
                                                <div className="h-2 w-full bg-zinc-800 rounded-full overflow-hidden">
                                                    <div className="h-full bg-purple-500" style={{width: `${Math.min(100, analysis.vocabulary.lexicalDiversity * 200)}%`}}></div>
                                                </div>
                                            </div>
                                            <div className="flex justify-between items-center py-2 border-t border-zinc-800/50">
                                                <span className="text-sm text-zinc-400">Unique Words</span>
                                                <Badge>{analysis.vocabulary.uniqueWords}</Badge>
                                            </div>
                                            <div className="flex justify-between items-center py-2 border-t border-zinc-800/50">
                                                <span className="text-sm text-zinc-400">Complex Words</span>
                                                <Badge color="bg-orange-500/20 text-orange-400">{analysis.vocabulary.complexWords}</Badge>
                                            </div>
                                        </div>
                                    </Card>

                                    <Card>
                                        <div className="flex items-center gap-2 mb-4">
                                            <Layers className="w-5 h-5 text-emerald-400" />
                                            <h2 className="text-lg font-semibold text-white">Sentiment Mix</h2>
                                        </div>
                                        <div className="flex h-4 w-full rounded-full overflow-hidden mb-4">
                                            <div className="bg-emerald-500" style={{width: `${analysis.sentiment.positive * 100}%`}}></div>
                                            <div className="bg-zinc-600" style={{width: `${analysis.sentiment.neutral * 100}%`}}></div>
                                            <div className="bg-red-500" style={{width: `${analysis.sentiment.negative * 100}%`}}></div>
                                        </div>
                                        <div className="space-y-2 text-sm">
                                            <div className="flex justify-between"><span className="text-emerald-400">Positive</span><span className="text-white">{(analysis.sentiment.positive * 100).toFixed(1)}%</span></div>
                                            <div className="flex justify-between"><span className="text-zinc-400">Neutral</span><span className="text-white">{(analysis.sentiment.neutral * 100).toFixed(1)}%</span></div>
                                            <div className="flex justify-between"><span className="text-red-400">Negative</span><span className="text-white">{(analysis.sentiment.negative * 100).toFixed(1)}%</span></div>
                                        </div>
                                    </Card>
                                </div>
                            </div>
                        </div>
                    ) : (
                        <div className="flex flex-col items-center justify-center py-20 text-center text-zinc-500 border border-dashed border-zinc-800 rounded-xl">
                            <Info className="w-12 h-12 mb-4 opacity-50" />
                            <p className="text-lg">Awaiting text input for analysis...</p>
                            <p className="text-sm mt-1 max-w-md">The engine runs locally in your browser using natural language processing formulas.</p>
                        </div>
                    )}
                </div>
            );
        }

        const root = createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
